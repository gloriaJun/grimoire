#!/usr/bin/env bash
# Sync ~/.claude and ~/.codex when the commit touched claude/ or
# ccstatusline/ ("committed = live"). codex-sync.sh runs after sync.sh
# because it reads the freshly synced ~/.claude state.
# Enable once with: git config core.hooksPath githooks
set -euo pipefail

REPO_DIR="$(git rev-parse --show-toplevel)"

if git diff-tree --no-commit-id --name-only -r HEAD | grep -qE '^(claude|ccstatusline)/'; then
  "$REPO_DIR/sync.sh"
  "$REPO_DIR/codex-sync.sh"
fi
