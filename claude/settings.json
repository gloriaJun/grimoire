{
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(pnpm nx:*)",
      "Bash(pnpm exec:*)",
      "Bash(brew install:*)",
      "Bash(brew upgrade:*)",
      "Bash(rtk *)",
      "Bash(plannotator:*)",
      "Plannotator:*",
      "Codex:*",
      "Bash(grep -E:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(* --version)",
      "Bash(* --help *)",
      "mcp__chrome-devtools__*",
      "WebSearch",
      "WebFetch(*)",
      "Read(~/.claude/**)",
      "Read(/Users/al03155147/.claude/**)",
      "Read(/Users/al03155147/Documents/GitHubPrivate/grimoire/**)",
      "Read(/Users/al03155147/Documents/GitHubWork/my-claude-skills/**)",
      "Read(/Users/al03155147/Documents/GitHubWork/_claude/**)",
      "Read(/Users/al03155147/Documents/GitHubPrivate/_claude/**)",
      "Read(/Users/al03155147/Documents/obsidian-vault/**)",
      "Bash(find /Users/al03155147/Documents/obsidian-vault:*)",
      "Bash(ls /Users/al03155147/Documents/obsidian-vault:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[[ -n \"$OPENAI_CODEX_API_KEY\" ]] && codex login --with-api-key <<< \"$OPENAI_CODEX_API_KEY\" 2>/dev/null || true",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/al03155147/.claude/hooks/memory-obsidian-link.sh",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/al03155147/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "matcher": "Bash(git commit:*)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'STOP: Before committing, you MUST run the pre-commit-check skill to review all staged changes. If you have already completed the pre-commit-check review for these changes, you may proceed.'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "mise exec 'npm:ccstatusline@latest' -- ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "plannotator@plannotator": true,
    "codex@openai-codex": true,
    "visualize@careerhackeralex": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "careerhackeralex": {
      "source": {
        "source": "github",
        "repo": "careerhackeralex/visualize"
      }
    }
  },
  "theme": "dark-daltonized",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}