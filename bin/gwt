#!/usr/bin/env bash
# gwt — git worktree + Claude launcher
# Usage: gwt <new|resume|list|rm|go> [args]
set -euo pipefail

VERSION="0.2.0"
GWT_SUBDIR=".claude/worktrees"

_git_root() {
  git rev-parse --show-toplevel 2>/dev/null || { echo "Error: not in a git repository" >&2; exit 1; }
}

_list_worktrees() {
  local root="$1"
  local wt_dir="$root/$GWT_SUBDIR"
  [[ -d "$wt_dir" ]] || return 0
  find "$wt_dir" -mindepth 1 -maxdepth 1 -type d | sort
}

_ensure_gitignore() {
  local root="$1"
  local gi="$root/.gitignore"
  local entry=".claude/worktrees/"
  if [[ -f "$gi" ]] && grep -qF "$entry" "$gi"; then
    return
  fi
  echo "$entry" >> "$gi"
  echo "Added '$entry' to .gitignore"
}

_has_fzf() { command -v fzf &>/dev/null; }

# Build fzf-ready lines: "name  branch[⚠]|/full/path"
# Returns non-zero if no worktrees found.
_worktree_fzf_lines() {
  local root="$1"
  local found=false
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    found=true
    local name; name=$(basename "$dir")
    local branch; branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "(detached)")
    local dirty=""
    if ! git -C "$dir" diff --quiet 2>/dev/null || ! git -C "$dir" diff --cached --quiet 2>/dev/null; then
      dirty="  ⚠"
    fi
    printf "%-20s  %s%s|%s\n" "$name" "$branch" "$dirty" "$dir"
  done < <(_list_worktrees "$root")
  $found
}

# Interactive fzf selector. Outputs selected /full/path on stdout.
# Returns non-zero if user cancels or no worktrees exist.
_fzf_pick_worktree() {
  local root="$1"
  local prompt="${2:-Select worktree}"
  local lines
  lines=$(_worktree_fzf_lines "$root") || { echo "No worktrees found." >&2; return 1; }

  local selected
  selected=$(echo "$lines" | fzf \
    --prompt="$prompt > " \
    --delimiter='|' \
    --with-nth=1 \
    --preview='git -C {2} log --oneline --color=always -15' \
    --preview-window='right:50%') || return 1

  echo "$selected" | awk -F'|' '{print $2}'
}

# Plain-text worktree list (used as fallback and internally).
_print_worktrees() {
  local root="$1"
  local wt_dir="$root/$GWT_SUBDIR"

  if [[ ! -d "$wt_dir" ]]; then
    echo "(no worktrees — directory not found: $GWT_SUBDIR)"
    return
  fi

  local i=1
  local found=false
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    found=true
    local name; name=$(basename "$dir")
    local branch; branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "(detached)")
    local dirty=""
    if ! git -C "$dir" diff --quiet 2>/dev/null || ! git -C "$dir" diff --cached --quiet 2>/dev/null; then
      dirty="  [uncommitted changes]"
    fi
    printf "  %d) %-20s → %s%s\n" "$i" "$name" "$branch" "$dirty"
    ((i++))
  done < <(_list_worktrees "$root")

  if ! $found; then
    echo "(no worktrees)"
  fi
}

cmd_new() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: gwt new <name> <branch> [base-branch]" >&2
    exit 1
  fi
  local name="$1"
  local branch="$2"
  local base="${3:-HEAD}"

  local root; root=$(_git_root)
  local path="$root/$GWT_SUBDIR/$name"

  if [[ -d "$path" ]]; then
    echo "Worktree '$name' already exists. Use: gwt resume $name" >&2
    exit 1
  fi

  mkdir -p "$root/$GWT_SUBDIR"
  _ensure_gitignore "$root"

  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    git -C "$root" worktree add "$path" "$branch"
  else
    git -C "$root" worktree add -b "$branch" "$path" "$base"
    echo "Created new branch: $branch"
  fi

  echo "Worktree '$name' → $path"
  echo "Launching claude..."
  cd "$path" && exec claude
}

cmd_resume() {
  local name="${1:-}"
  local root; root=$(_git_root)

  if [[ -z "$name" ]]; then
    if _has_fzf; then
      local path
      path=$(_fzf_pick_worktree "$root" "Resume worktree") || exit 0
      echo "Resuming '$(basename "$path")' at: $path"
      cd "$path" && exec claude
    else
      echo "Available worktrees:"
      _print_worktrees "$root"
    fi
    exit 0
  fi

  local path="$root/$GWT_SUBDIR/$name"
  if [[ ! -d "$path" ]]; then
    echo "Worktree '$name' not found." >&2
    echo ""
    _print_worktrees "$root"
    exit 1
  fi

  echo "Resuming '$name' at: $path"
  cd "$path" && exec claude
}

cmd_list() {
  local root; root=$(_git_root)

  if _has_fzf; then
    local lines
    lines=$(_worktree_fzf_lines "$root") || { echo "(no worktrees)"; return; }
    echo "$lines" | fzf \
      --prompt="worktrees > " \
      --delimiter='|' \
      --with-nth=1 \
      --preview='git -C {2} log --oneline --color=always -15' \
      --preview-window='right:50%' \
      --bind='enter:execute(echo {2})+abort' \
      --header='Enter: print path  •  ESC: quit' \
      || true
  else
    _print_worktrees "$root"
  fi
}

cmd_rm() {
  local root; root=$(_git_root)
  local wt_dir="$root/$GWT_SUBDIR"

  if [[ ! -d "$wt_dir" ]]; then
    echo "No worktrees found."
    exit 0
  fi

  local target_path target_name

  if _has_fzf; then
    target_path=$(_fzf_pick_worktree "$root" "Remove worktree") || { echo "Cancelled."; exit 0; }
    target_name=$(basename "$target_path")
  else
    local -a names=()
    local -a paths=()
    while IFS= read -r dir; do
      [[ -d "$dir" ]] || continue
      names+=("$(basename "$dir")")
      paths+=("$dir")
    done < <(_list_worktrees "$root")

    if [[ ${#names[@]} -eq 0 ]]; then
      echo "No worktrees to remove."
      exit 0
    fi

    echo "Select worktree to remove:"
    for i in "${!names[@]}"; do
      local branch; branch=$(git -C "${paths[$i]}" branch --show-current 2>/dev/null || echo "(detached)")
      local dirty=""
      if ! git -C "${paths[$i]}" diff --quiet 2>/dev/null || ! git -C "${paths[$i]}" diff --cached --quiet 2>/dev/null; then
        dirty="  ⚠ uncommitted changes"
      fi
      printf "  %d) %-20s → %s%s\n" "$((i+1))" "${names[$i]}" "$branch" "$dirty"
    done
    echo "  0) cancel"

    local choice
    read -r -p "Choice: " choice

    if [[ "$choice" == "0" ]] || [[ -z "$choice" ]]; then
      echo "Cancelled."
      exit 0
    fi

    if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
      echo "Invalid choice." >&2
      exit 1
    fi

    local idx=$((choice - 1))
    if [[ $idx -lt 0 ]] || [[ $idx -ge ${#names[@]} ]]; then
      echo "Invalid choice." >&2
      exit 1
    fi

    target_path="${paths[$idx]}"
    target_name="${names[$idx]}"
  fi

  if ! git -C "$target_path" diff --quiet 2>/dev/null || ! git -C "$target_path" diff --cached --quiet 2>/dev/null; then
    echo ""
    echo "⚠  '$target_name' has uncommitted changes:"
    git -C "$target_path" status --short
    echo ""
    local confirm
    read -r -p "Remove anyway? [y/N] " confirm
    if [[ "$confirm" != "y" ]] && [[ "$confirm" != "Y" ]]; then
      echo "Cancelled."
      exit 0
    fi
  fi

  git -C "$root" worktree remove --force "$target_path"
  echo "Removed worktree: $target_name"
}

cmd_go() {
  local name="${1:-}"
  local root; root=$(_git_root)

  local path
  if [[ -z "$name" ]]; then
    _has_fzf || { echo "Error: fzf required for interactive selection" >&2; exit 1; }
    path=$(_fzf_pick_worktree "$root" "Go to worktree") || exit 0
  else
    path="$root/$GWT_SUBDIR/$name"
    [[ -d "$path" ]] || { echo "Worktree '$name' not found." >&2; exit 1; }
  fi

  # Output path only — shell function wrapper does the actual cd
  echo "$path"
}

_help() {
  echo "gwt v$VERSION — git worktree + Claude launcher"
  echo ""
  echo "Usage: gwt <command> [args]"
  echo ""
  echo "Commands:"
  echo "  new <name> <branch> [base]  Create worktree on <branch> and launch claude"
  echo "  resume [name]               Launch claude in existing worktree (fzf if omitted)"
  echo "  list                        Browse worktrees interactively with fzf"
  echo "  rm                          Select and remove a worktree (fzf + uncommit check)"
  echo "  go [name]                   cd to worktree directory (requires shell wrapper)"
  echo ""
  echo "Options:"
  echo "  -v, --version               Show version"
  echo "  -h, --help                  Show this help"
  echo ""
  echo "Worktrees are stored under: <git-root>/$GWT_SUBDIR/"
}

case "${1:-help}" in
  new)              shift; cmd_new "$@" ;;
  resume)           shift; cmd_resume "${1:-}" ;;
  list)             cmd_list ;;
  rm)               cmd_rm ;;
  go)               shift; cmd_go "${1:-}" ;;
  -v|--version)     echo "gwt v$VERSION" ;;
  -h|--help|help)   _help ;;
  *)
    echo "gwt: unknown command '${1}'" >&2
    echo "Run 'gwt --help' for usage." >&2
    exit 1
    ;;
esac
