#!/usr/bin/env bash
# cwt — Claude WorkTree: git worktree + Claude launcher
# Usage: cwt <new|resume|list|rm|go> [args]
#
# Shell integration (enables 'go' cd support):
#   Add to ~/.zshrc:  source ~/.local/bin/cwt
#   Then run:         source ~/.zshrc

# --- Source detection (bash & zsh compatible) ---
_CWT_SOURCED=false
if [[ -n "${ZSH_VERSION:-}" ]]; then
  [[ "${ZSH_EVAL_CONTEXT:-}" == *:file* ]] && _CWT_SOURCED=true
elif [[ -n "${BASH_VERSION:-}" ]]; then
  [[ "${BASH_SOURCE[0]:-}" != "${0}" ]] && _CWT_SOURCED=true
fi

# Enable strict error handling only in script mode.
# In sourced mode this would modify the user's shell options.
[[ "$_CWT_SOURCED" != "true" ]] && set -euo pipefail

VERSION="0.4.0"
GWT_SUBDIR=".claude/worktrees"

_git_root() {
  git rev-parse --show-toplevel 2>/dev/null || { echo "Error: not in a git repository" >&2; exit 1; }
}

_list_worktrees() {
  local root="$1"
  local wt_dir="$root/$GWT_SUBDIR"
  [[ -d "$wt_dir" ]] || return 0
  find "$wt_dir" -mindepth 1 -maxdepth 1 -type d | sort
}

_ensure_gitignore() {
  local root="$1"
  local gi="$root/.gitignore"
  local entry=".claude/worktrees/"
  if [[ -f "$gi" ]] && grep -qF "$entry" "$gi"; then
    return
  fi
  echo "$entry" >> "$gi"
  echo "Added '$entry' to .gitignore"
}

_has_fzf() { command -v fzf &>/dev/null; }

# Build fzf-ready lines: "name  branch[⚠]|/full/path"
# Returns non-zero if no worktrees found.
_worktree_fzf_lines() {
  local root="$1"
  local found=false
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    found=true
    local name; name=$(basename "$dir")
    local branch; branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "(detached)")
    local dirty=""
    if ! git -C "$dir" diff --quiet 2>/dev/null || ! git -C "$dir" diff --cached --quiet 2>/dev/null; then
      dirty="  ⚠"
    fi
    printf "%-20s  %s%s|%s\n" "$name" "$branch" "$dirty" "$dir"
  done < <(_list_worktrees "$root")
  $found
}

# Interactive fzf selector. Outputs selected /full/path on stdout.
# Returns non-zero if user cancels or no worktrees exist.
_fzf_pick_worktree() {
  local root="$1"
  local prompt="${2:-Select worktree}"
  local lines
  lines=$(_worktree_fzf_lines "$root") || { echo "No worktrees found." >&2; return 1; }

  local selected
  selected=$(echo "$lines" | fzf \
    --prompt="$prompt > " \
    --delimiter='|' \
    --with-nth=1 \
    --preview='git -C {2} log --oneline --color=always -15' \
    --preview-window='right:50%') || return 1

  echo "$selected" | awk -F'|' '{print $2}'
}

# Multi-select fzf selector. Outputs one /full/path per line on stdout.
# Returns non-zero if user cancels or no worktrees exist.
_fzf_pick_worktrees() {
  local root="$1"
  local prompt="${2:-Select worktrees}"
  local lines
  lines=$(_worktree_fzf_lines "$root") || { echo "No worktrees found." >&2; return 1; }

  local selected
  selected=$(echo "$lines" | fzf \
    --multi \
    --prompt="$prompt > " \
    --delimiter='|' \
    --with-nth=1 \
    --preview='git -C {2} log --oneline --color=always -15' \
    --preview-window='right:50%' \
    --header='TAB: toggle  •  ENTER: confirm  •  ESC: cancel') || return 1

  echo "$selected" | awk -F'|' '{print $2}'
}

# Plain-text worktree list (used as fallback and internally).
_print_worktrees() {
  local root="$1"
  local wt_dir="$root/$GWT_SUBDIR"

  if [[ ! -d "$wt_dir" ]]; then
    echo "(no worktrees — directory not found: $GWT_SUBDIR)"
    return
  fi

  local i=1
  local found=false
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    found=true
    local name; name=$(basename "$dir")
    local branch; branch=$(git -C "$dir" branch --show-current 2>/dev/null || echo "(detached)")
    local dirty=""
    if ! git -C "$dir" diff --quiet 2>/dev/null || ! git -C "$dir" diff --cached --quiet 2>/dev/null; then
      dirty="  [uncommitted changes]"
    fi
    printf "  %d) %-20s → %s%s\n" "$i" "$name" "$branch" "$dirty"
    ((i++))
  done < <(_list_worktrees "$root")

  if ! $found; then
    echo "(no worktrees)"
  fi
}

cmd_new() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: cwt new <name> <branch> [base-branch]" >&2
    return 1
  fi
  local name="$1"
  local branch="$2"
  local base="${3:-HEAD}"

  local root; root=$(_git_root) || return 1
  local path="$root/$GWT_SUBDIR/$name"

  if [[ -d "$path" ]]; then
    echo "Worktree '$name' already exists. Use: cwt resume $name" >&2
    return 1
  fi

  mkdir -p "$root/$GWT_SUBDIR"
  _ensure_gitignore "$root"

  if git -C "$root" show-ref --verify --quiet "refs/heads/$branch" 2>/dev/null; then
    git -C "$root" worktree add "$path" "$branch"
  else
    git -C "$root" worktree add -b "$branch" "$path" "$base"
    echo "Created new branch: $branch"
  fi

  echo "Worktree '$name' → $path"
  echo "Launching claude..."
  cd "$path" && exec claude
}

cmd_resume() {
  local name="${1:-}"
  local root; root=$(_git_root) || return 1

  if [[ -z "$name" ]]; then
    if _has_fzf; then
      local path
      path=$(_fzf_pick_worktree "$root" "Resume worktree") || return 0
      echo "Resuming '$(basename "$path")' at: $path"
      cd "$path" && exec claude
    else
      echo "Available worktrees:"
      _print_worktrees "$root"
    fi
    return 0
  fi

  local path="$root/$GWT_SUBDIR/$name"
  if [[ ! -d "$path" ]]; then
    echo "Worktree '$name' not found." >&2
    echo ""
    _print_worktrees "$root"
    return 1
  fi

  echo "Resuming '$name' at: $path"
  cd "$path" && exec claude
}

cmd_list() {
  local root; root=$(_git_root) || return 1

  if _has_fzf; then
    local lines
    lines=$(_worktree_fzf_lines "$root") || { echo "(no worktrees)"; return; }
    echo "$lines" | fzf \
      --prompt="worktrees > " \
      --delimiter='|' \
      --with-nth=1 \
      --preview='git -C {2} log --oneline --color=always -15' \
      --preview-window='right:50%' \
      --bind='enter:execute(echo {2})+abort' \
      --header='Enter: print path  •  ESC: quit' \
      || true
  else
    _print_worktrees "$root"
  fi
}

_do_remove() {
  local root="$1" path="$2"
  local name; name=$(basename "$path")
  if git -C "$root" worktree remove --force "$path" 2>/dev/null; then
    printf "  ✓  %s\n" "$name"
  else
    printf "  ✗  %s  (failed)\n" "$name" >&2
    return 1
  fi
}

cmd_rm() {
  local root; root=$(_git_root) || return 1
  local wt_dir="$root/$GWT_SUBDIR"

  if [[ ! -d "$wt_dir" ]]; then
    echo "No worktrees found."
    return 0
  fi

  local -a target_paths=()

  if _has_fzf; then
    local selected
    selected=$(_fzf_pick_worktrees "$root" "Remove worktree(s)") || { echo "Cancelled."; return 0; }
    while IFS= read -r path; do
      [[ -n "$path" ]] && target_paths+=("$path")
    done <<< "$selected"
  else
    local -a names=()
    local -a paths=()
    while IFS= read -r dir; do
      [[ -d "$dir" ]] || continue
      names+=("$(basename "$dir")")
      paths+=("$dir")
    done < <(_list_worktrees "$root")

    if [[ ${#names[@]} -eq 0 ]]; then
      echo "No worktrees to remove."
      return 0
    fi

    echo "Select worktree(s) to remove (space or comma separated, 0 to cancel):"
    for i in "${!names[@]}"; do
      local branch; branch=$(git -C "${paths[$i]}" branch --show-current 2>/dev/null || echo "(detached)")
      local dirty=""
      if ! git -C "${paths[$i]}" diff --quiet 2>/dev/null || ! git -C "${paths[$i]}" diff --cached --quiet 2>/dev/null; then
        dirty="  ⚠ uncommitted changes"
      fi
      printf "  %d) %-20s → %s%s\n" "$((i+1))" "${names[$i]}" "$branch" "$dirty"
    done
    echo "  0) cancel"

    local input
    read -r -p "Choice(s): " input

    if [[ -z "$input" || "$input" == "0" ]]; then
      echo "Cancelled."
      return 0
    fi

    local -a choices=()
    IFS=', ' read -ra choices <<< "$input"
    for choice in "${choices[@]}"; do
      [[ -z "$choice" || "$choice" == "0" ]] && continue
      if ! [[ "$choice" =~ ^[0-9]+$ ]]; then
        echo "Invalid choice: $choice" >&2
        return 1
      fi
      local idx=$((choice - 1))
      if [[ $idx -lt 0 || $idx -ge ${#names[@]} ]]; then
        echo "Invalid choice: $choice" >&2
        return 1
      fi
      target_paths+=("${paths[$idx]}")
    done
  fi

  if [[ ${#target_paths[@]} -eq 0 ]]; then
    echo "No worktrees selected."
    return 0
  fi

  # Check dirty state for all selected — prompt serially before any deletion starts
  local -a confirmed_paths=()
  for target_path in "${target_paths[@]}"; do
    local target_name; target_name=$(basename "$target_path")
    if ! git -C "$target_path" diff --quiet 2>/dev/null || ! git -C "$target_path" diff --cached --quiet 2>/dev/null; then
      echo ""
      echo "⚠  '$target_name' has uncommitted changes:"
      git -C "$target_path" status --short
      echo ""
      local confirm
      read -r -p "Remove '$target_name' anyway? [y/N] " confirm
      if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        echo "  Skipped: $target_name"
        continue
      fi
    fi
    confirmed_paths+=("$target_path")
  done

  if [[ ${#confirmed_paths[@]} -eq 0 ]]; then
    echo "Nothing to remove."
    return 0
  fi

  echo ""
  if [[ ${#confirmed_paths[@]} -eq 1 ]]; then
    _do_remove "$root" "${confirmed_paths[0]}"
  else
    echo "Removing ${#confirmed_paths[@]} worktrees..."
    local -a pids=()
    for target_path in "${confirmed_paths[@]}"; do
      _do_remove "$root" "$target_path" &
      pids+=($!)
    done

    local failed=0
    for pid in "${pids[@]}"; do
      wait "$pid" || ((failed++))
    done

    echo ""
    echo "Done: $((${#confirmed_paths[@]} - failed))/${#confirmed_paths[@]} removed"
    [[ $failed -gt 0 ]] && return 1
  fi
}

cmd_go() {
  local name="${1:-}"
  local root; root=$(_git_root) || return 1

  local path
  if [[ -z "$name" ]]; then
    _has_fzf || { echo "Error: fzf required for interactive selection" >&2; return 1; }
    path=$(_fzf_pick_worktree "$root" "Go to worktree") || return 0
  else
    path="$root/$GWT_SUBDIR/$name"
    [[ -d "$path" ]] || { echo "Worktree '$name' not found." >&2; return 1; }
  fi

  if [[ "$_CWT_SOURCED" == "true" ]]; then
    builtin cd "$path"
  else
    echo "$path"
    local label="${name:-$(basename "$path")}"
    printf '\nTo navigate, run:\n  cd "$(cwt go %s)"\n' "$label" >&2
  fi
}

cmd_show() {
  local root; root=$(_git_root) || return 1
  local found=false
  while IFS= read -r dir; do
    [[ -d "$dir" ]] || continue
    found=true
    basename "$dir"
  done < <(_list_worktrees "$root")
  $found || echo "(no worktrees)"
}

cmd_exec() {
  if [[ $# -lt 2 ]]; then
    echo "Usage: cwt exec <name> <command> [args...]" >&2
    return 1
  fi
  local name="$1"
  shift
  local root; root=$(_git_root) || return 1
  local path="$root/$GWT_SUBDIR/$name"
  [[ -d "$path" ]] || { echo "Worktree '$name' not found." >&2; return 1; }
  (cd "$path" && "$@")
}

_help() {
  echo "cwt v$VERSION — Claude WorkTree: git worktree + Claude launcher"
  echo ""
  echo "Usage: cwt <command> [args]"
  echo ""
  echo "Commands:"
  echo "  new <name> <branch> [base]  Create worktree on <branch> and launch claude"
  echo "  resume [name]               Launch claude in existing worktree (fzf if omitted)"
  echo "  show                        List worktree names"
  echo "  list                        Browse worktrees interactively with fzf"
  echo "  go [name]                   Print worktree path (fzf if omitted)"
  echo "  exec <name> <cmd> [args]    Run command inside a worktree"
  echo "  rm                          Select and remove worktree(s) (multi-select, parallel, uncommit check)"
  echo ""
  echo "Options:"
  echo "  -v, --version               Show version"
  echo "  -h, --help                  Show this help"
  echo ""
  echo "Worktrees are stored under: <git-root>/$GWT_SUBDIR/"
  echo ""
  echo "Navigation:"
  echo "  cwt go <name>               prints the path"
  echo "  cd \"\$(cwt go <name>)\"       cd into the worktree"
  echo ""
  echo "Examples:"
  echo "  cwt new feat feat/my-feature"
  echo "  cwt show"
  echo "  cd \"\$(cwt go feat)\""
  echo "  cwt exec feat git status"
}

_cwt_dispatch() {
  case "${1:-help}" in
    new)           shift; cmd_new "$@" ;;
    resume)        shift; cmd_resume "${1:-}" ;;
    show)          cmd_show ;;
    list)          cmd_list ;;
    go)            shift; cmd_go "${1:-}" ;;
    exec)          shift; cmd_exec "$@" ;;
    rm)            cmd_rm ;;
    -v|--version)  echo "cwt v$VERSION" ;;
    -h|--help|help) _help ;;
    *)
      echo "cwt: unknown command '${1}'" >&2
      echo "Run 'cwt --help' for usage." >&2
      return 1
      ;;
  esac
}

if [[ "$_CWT_SOURCED" == "true" ]]; then
  cwt() { _cwt_dispatch "$@"; }   # define function in current shell; go can builtin cd
else
  _cwt_dispatch "$@"              # run directly as script
fi
